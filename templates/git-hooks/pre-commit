#!/usr/bin/env bash
# ADLC pre-commit: fast checks on staged files only. The full suite runs once, in CI.
# Written for bash 3.2 (the macOS default): no mapfile or other bash 4 features.
set -euo pipefail
files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)
[ "${#files[@]}" -eq 0 ] && exit 0
exec .adlc/fast-check "${files[@]}"
